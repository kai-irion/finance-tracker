NEXT_PUBLIC_SUPABASE_URL=SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUPABASE_ANON_KEY

# Server-only — used by API routes (src/lib/supabase/admin-client.ts) to bypass Row Level
# Security (see supabase/migrations/010_enable_rls.sql), since server routes have no browser
# session to authenticate with. Dashboard -> Project Settings -> API -> "service_role" key.
# NEVER prefix this with NEXT_PUBLIC_ — it must never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY

# Coinbase CDP Cloud API Key (Ed25519). Server-side only — no NEXT_PUBLIC_ prefix.
# Create at coinbase.com -> Settings -> API -> "New API Key", scopes wallet:accounts:read
# and wallet:transactions:read only. COINBASE_API_KEY is the full key name
# ("organizations/{org_id}/apiKeys/{key_id}"), COINBASE_API_SECRET is the base64-encoded
# Ed25519 private key shown once at creation time.
COINBASE_API_KEY=COINBASE_API_KEY
COINBASE_API_SECRET=COINBASE_API_SECRET

# Enable Banking (PSD2 open banking aggregator) — used for the Revolut integration.
# Register an application at https://enablebanking.com/ to get the App ID; registration
# also generates an RSA key pair (see enable-banking-keys/ in the project root — the
# private key itself must never be committed, only its local file path below).
ENABLE_BANKING_APP_ID=ENABLE_BANKING_APP_ID
ENABLE_BANKING_PRIVATE_KEY_PATH=/absolute/path/to/enable-banking-keys/private.key

# Demo mode (FinanceHub-demo only): "true" bypasses the Google login, hides bank
# sync/connect UI and AI features, and disables the sync/classify API routes.
# The demo database holds only generated dummy data — see README-DEMO.md.
NEXT_PUBLIC_DEMO_MODE=true

# Google sign-in gate (see src/components/auth-gate.tsx) — enable the Google provider in
# Supabase Dashboard -> Authentication -> Providers first. Only this email is let past the
# gate; everyone else who signs in sees an "access denied" screen.
# Not needed for the demo (gate is bypassed) — leave unset.
# NEXT_PUBLIC_ALLOWED_EMAIL=your@email.com
