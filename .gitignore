# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python-sync (TradeRepublic sync script)
python-sync/.venv/
python-sync/.session_cache/
python-sync/*.log
__pycache__/
*.pyc

# imports (CSV drop folder for Wise/PayPal import) — keep the folder structure, not the files
/imports/*
!/imports/.gitkeep
!/imports/processed/
/imports/processed/*
!/imports/processed/.gitkeep

# enable banking (private key must never be committed)
/enable-banking-keys/
